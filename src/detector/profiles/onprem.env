# 온프레미스 GPU 서버 측정 프로필 (예시). 지표 1 오프라인 채점용.
#
# 지표 2(실제 Claude Code)는 브리지 5초·훅 10초 제한이 있어 이 timeout이 그대로 적용되지 않는다.
# (브리지: Native Mod가 탐지기를 부르는 src/detector/mcp-bridge.cjs, PG_DETECTOR_TIMEOUT_MS 기본 5000.
#  훅: Claude Code 엔진이 Mod 훅 하나에 주는 시간.) 둘이 모델보다 먼저 끊으므로, 60초짜리 모델 호출은
# 지표 2에서는 실패(fail-closed)로 끝난다. 이 파일은 채점기(promptguard-data metric-detection)로 오프라인
# 채점할 때만 쓴다.
#
# 제품 기본값(src/detector/detector.json: ml-span·ml-v9·검증기 device cpu, timeout 4초)은 바꾸지 않는다.
# 아래 값은 환경변수로만 그 위에 덮어쓴다. 쓰는 법:
#   python scripts/eval_integration/run.py --env-file src/detector/profiles/onprem.env ...
#   (또는 셸에서: set -a; . src/detector/profiles/onprem.env; set +a)

# ml-span, ml-v9의 장치 (cpu | cuda | mps | auto). ml-qwen은 detector.json의 device를 그대로 쓴다.
PG_ML_DEVICE=cuda
# 검증기(--policy verifier)의 장치.
PG_VERIFIER_DEVICE=cuda
# ml-span, ml-v9, ml-qwen, 검증기 모두의 호출 제한(초). ml-span·ml-v9의 scope full 기본 25초도 덮는다.
PG_ML_TIMEOUT_SECONDS=60

# ml-span 체크포인트(번들 폴더). 모델 저장소(promptguard-model) 기준 상대 경로 또는 절대 경로.
# 비우면 detector.json대로 모델 저장소가 기본으로 지정한 번들(없으면 models/span-detector-v10)을 쓴다.
PG_ML_CHECKPOINT=models/<온프레미스 span 번들 폴더>
# 검증기 번들 폴더. 모델 저장소 기준 상대 경로 또는 절대 경로.
PG_VERIFIER_BUNDLE=runs/verifier/<온프레미스 검증기 번들 폴더>

# ml-span을 켜려면(기본은 꺼져 있음):
# PG_DETECTOR_ENABLE=ml-span
# 검증기를 쓰려면(기본 정책은 union):
# PG_DETECTOR_CANDIDATE_POLICY=verifier
