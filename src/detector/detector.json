{
  "consensus": { "mode": "majority" },
  "candidate_policy": "union",
  "adapters": [
    {
      "name": "credsweeper",
      "type": "credsweeper",
      "required": true,
      "options": {
        "severity": "medium",
        "confidence": "moderate",
        "extra_rules": ["pgdetector/adapters/credsweeper-rules.yaml"]
      }
    },
    {
      "name": "gitleaks",
      "type": "gitleaks",
      "required": false,
      "options": {
        "binary": "gitleaks",
        "config": null,
        "timeout_seconds": 10
      }
    },
    {
      "name": "promptguard-rules",
      "type": "patterns",
      "required": true,
      "options": {
        "min_value_length": 8
      }
    },
    {
      "name": "shell-aware",
      "type": "shell-aware",
      "required": true,
      "candidate_only": true,
      "options": {
        "min_value_length": 1
      }
    },
    {
      "name": "ml-v9",
      "type": "ml-v9",
      "enabled": false,
      "required": false,
      "candidate_only": true,
      "options": {
        "repository": "../../../promptguard-model",
        "checkpoint": "default",
        "fallback_checkpoint": "models/span-detector-v10",
        "device": "cpu",
        "gate": "always",
        "timeout_seconds": 4,
        "long_text": "cue_windows",
        "whole_text_chars": 2000,
        "window_lines": 2,
        "max_text_chars": 6000,
        "too_long": "skip"
      }
    },
    {
      "name": "ml-qwen",
      "type": "ml-qwen",
      "enabled": false,
      "required": false,
      "candidate_only": true,
      "options": {
        "repository": "../../../promptguard-model",
        "bundle": "default",
        "fallback_bundle": "models/qwen-span-v3",
        "device": "auto",
        "gate": "cue",
        "timeout_seconds": 25,
        "max_chunks": 8,
        "overlap_lines": 1,
        "max_text_chars": 12000,
        "too_long": "skip"
      }
    }
  ]
}
