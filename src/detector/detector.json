{
  "consensus": { "mode": "majority" },
  "adapters": [
    {
      "name": "credsweeper",
      "type": "credsweeper",
      "required": true,
      "options": {
        "severity": "medium",
        "confidence": "moderate",
        "extra_rules": ["pgdetector/adapters/credsweeper-rules.yaml"]
      }
    },
    {
      "name": "gitleaks",
      "type": "gitleaks",
      "required": false,
      "options": {
        "binary": "gitleaks",
        "config": null,
        "timeout_seconds": 10,
        "max_parallel": 4
      }
    },
    {
      "name": "promptguard-rules",
      "type": "patterns",
      "required": true,
      "options": {
        "min_value_length": 8
      }
    },
    {
      "name": "ml-detector",
      "type": "ml-span",
      "required": false,
      "candidate_only": true,
      "options": {
        "repository": "../../../promptguard-model",
        "checkpoint": "models/span-detector-v9",
        "device": "cpu",
        "strong_threshold": 0.9999
      }
    },
    {
      "name": "shell-aware",
      "type": "shell-aware",
      "required": true,
      "candidate_only": true,
      "options": {
        "min_value_length": 1
      }
    }
  ]
}
