{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptguard.local/schemas/runtime-v1-config.json",
  "title": "PromptGuard Runtime V1 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "claudeBinary",
    "claudeVersion",
    "strictClaudeVersion",
    "pythonBinary",
    "guardHost",
    "guardPort",
    "modDetectorPort",
    "guardDetectorPort",
    "detectorTimeoutMs",
    "maxBodyBytes",
    "workerRestartLimit",
    "restartBackoffMs",
    "restartBackoffMaxMs",
    "healthCheckIntervalMs",
    "healthFailureThreshold",
    "readinessTimeoutMs",
    "shutdownTimeoutMs",
    "auditPath",
    "logLevel",
    "upstreamBaseUrl"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "claudeBinary": { "type": "string", "minLength": 1 },
    "claudeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "strictClaudeVersion": { "type": "boolean" },
    "pythonBinary": { "type": "string", "minLength": 1 },
    "guardHost": { "enum": ["127.0.0.1", "localhost", "::1"] },
    "guardPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "modDetectorPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "guardDetectorPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "detectorTimeoutMs": { "type": "integer", "minimum": 50, "maximum": 60000 },
    "maxBodyBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864 },
    "workerRestartLimit": { "type": "integer", "minimum": 0, "maximum": 100 },
    "restartBackoffMs": { "type": "integer", "minimum": 10, "maximum": 60000 },
    "restartBackoffMaxMs": { "type": "integer", "minimum": 10, "maximum": 300000 },
    "healthCheckIntervalMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
    "healthFailureThreshold": { "type": "integer", "minimum": 1, "maximum": 20 },
    "readinessTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
    "shutdownTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
    "auditPath": { "type": "string", "minLength": 1 },
    "logLevel": { "enum": ["error", "warn", "info", "debug"] },
    "upstreamBaseUrl": { "type": "string", "format": "uri" }
  }
}
